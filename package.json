{
  "name": "@tlapalli/ollin",
  "version": "0.1.0-alpha.0",
  "description": "2D/2.5D game engine in TypeScript: data-oriented ECS, WASM and plugins.",
  "keywords": [
    "game-engine",
    "2d",
    "webgl2",
    "ecs",
    "wasm",
    "rapier",
    "tiled",
    "isometric"
  ],
  "license": "MIT",
  "author": "Diego Resendez",
  "homepage": "https://tlapalli.github.io/ollin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tlapalli/ollin.git"
  },
  "bugs": "https://github.com/Tlapalli/ollin/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rapier": {
      "types": "./dist/rapier.d.ts",
      "import": "./dist/rapier.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite examples",
    "test": "vitest run",
    "typecheck": "tsc",
    "build": "vite build -c vite.lib.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@dimforge/rapier2d-simd-compat": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier2d-simd-compat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier2d-simd-compat": "^0.21.0",
    "phaser": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
